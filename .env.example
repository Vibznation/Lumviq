# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lumviq_db

# App
NEXT_PUBLIC_APP_NAME=Lumviq

# JWT
JWT_SECRET=please-change-this-to-a-secure-random-value

# Prisma
# Example: export DATABASE_URL="postgresql://user:pass@localhost:5432/db"

# App base URL, used to build links in outbound emails (invites, portal links)
APP_URL=http://localhost:3000

# Background jobs (POST /api/jobs/process). If unset, only logged-in users
# may trigger job processing; set this to allow an external cron caller.
JOBS_PROCESS_SECRET=

# Outbound email (SMTP). If any of these are unset, emails are only logged
# to the EmailLog table (never silently "pretend-sent") — see
# src/lib/integrations/email.ts. Works with any SMTP provider (Postmark,
# SendGrid SMTP relay, Mailgun, Amazon SES SMTP, etc).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Payments (Stripe test mode). Leave unset to keep "Pay Online" hidden/
# disabled with an honest "not configured" message — see
# src/lib/integrations/payments.ts.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Bank feeds (Plaid sandbox). Leave unset to keep bank feeds "Not
# connected" — see src/lib/integrations/bank-feed.ts.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Don't put secrets here; use real env vars in production
