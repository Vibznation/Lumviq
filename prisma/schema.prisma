model Program {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("programs")
}

model ExchangeRate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  baseCurrency   String    @map("base_currency")
  quoteCurrency  String    @map("quote_currency")
  rate           Decimal   @db.Decimal(20, 8)
  asOfDate       DateTime  @map("as_of_date")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, baseCurrency, quoteCurrency, asOfDate])
  @@map("exchange_rates")
}

model Dimension {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values         DimensionValue[]

  @@unique([organizationId, name])
  @@map("dimensions")
}

model DimensionValue {
  id            String    @id @default(uuid()) @db.Uuid
  dimensionId   String    @map("dimension_id")
  name          String
  createdAt     DateTime  @default(now()) @map("created_at")

  dimension     Dimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  journalLines  JournalLine[]

  @@unique([dimensionId, name])
  @@map("dimension_values")
}

/// Lightweight 1099 contractor directory entry, optionally linked to a
/// Vendor record used for bill payments.
model Contractor {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  vendorId       String?   @map("vendor_id")
  name           String
  email          String?
  taxIdLast4     String?   @map("tax_id_last4")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@map("contractors")
}

/// Audit log of every Lumviq Intelligence computation, so insights are
/// traceable even though they are computed live and not stored elsewhere.
model AiInteraction {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  userId         String?   @map("user_id")
  kind           String
  basis          String?
  inputSummary   Json?     @map("input_summary")
  outputSummary  Json?     @map("output_summary")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ai_interactions")
}

/// Outbound webhook subscriptions for the public API (not yet exposed —
/// see src/lib/webhooks.ts).
model Webhook {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  url            String
  secret         String
  eventTypes     String[]  @default([]) @map("event_types")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id           String    @id @default(uuid()) @db.Uuid
  webhookId    String    @map("webhook_id")
  eventType    String    @map("event_type")
  payload      Json
  status       String    @default("pending")
  responseCode Int?      @map("response_code")
  attempt      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")

  webhook      Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}

/// Sales estimate/quote, convertible to an Invoice once accepted.
model Estimate {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id")
  customerId     String        @map("customer_id")
  estimateNumber String        @map("estimate_number")
  status         String        @default("draft")
  issueDate      DateTime      @map("issue_date")
  expiryDate     DateTime?     @map("expiry_date")
  currency       String        @default("USD")
  subtotal       Decimal       @db.Decimal(20, 6)
  taxRateId      String?       @map("tax_rate_id")
  taxTotal       Decimal       @default(0) @db.Decimal(20, 6) @map("tax_total")
  total          Decimal       @db.Decimal(20, 6)
  convertedInvoiceId String?   @unique @map("converted_invoice_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines          EstimateLine[]

  @@unique([organizationId, estimateNumber])
  @@map("estimates")
}

model EstimateLine {
  id          String   @id @default(uuid()) @db.Uuid
  estimateId  String   @map("estimate_id")
  description String
  quantity    Decimal  @default(1) @db.Decimal(20, 6)
  unitPrice   Decimal  @db.Decimal(20, 6) @map("unit_price")
  amount      Decimal  @db.Decimal(20, 6)
  accountId   String   @map("account_id")
  productId   String?  @map("product_id")
  createdAt   DateTime @default(now()) @map("created_at")

  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@map("estimate_lines")
}

/// Purchase order sent to a vendor, convertible to a Bill once received.
model PurchaseOrder {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id")
  vendorId       String        @map("vendor_id")
  poNumber       String        @map("po_number")
  status         String        @default("draft")
  issueDate      DateTime      @map("issue_date")
  expectedDate   DateTime?     @map("expected_date")
  currency       String        @default("USD")
  subtotal       Decimal       @db.Decimal(20, 6)
  total          Decimal       @db.Decimal(20, 6)
  convertedBillId String?      @unique @map("converted_bill_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines          PurchaseOrderLine[]
  receipts       PurchaseOrderReceipt[]

  @@unique([organizationId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @map("purchase_order_id")
  description     String
  quantity        Decimal       @default(1) @db.Decimal(20, 6)
  unitPrice       Decimal       @db.Decimal(20, 6) @map("unit_price")
  amount          Decimal       @db.Decimal(20, 6)
  accountId       String        @map("account_id")
  productId       String?       @map("product_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_lines")
}

/// Recurring invoice/bill template. "Run now" (or a future scheduler)
/// generates a real Invoice/Bill from templateLines against nextRunDate.
model RecurringTemplate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  type           String
  partyId        String    @map("party_id")
  frequency      String    @default("monthly")
  nextRunDate    DateTime  @map("next_run_date")
  lastRunAt      DateTime? @map("last_run_at")
  active         Boolean   @default(true)
  taxRateId      String?   @map("tax_rate_id")
  templateLines  Json      @map("template_lines")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("recurring_templates")
}

/// Credit memo from a vendor, reducing what the organization owes them.
model VendorCredit {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id")
  vendorId         String    @map("vendor_id")
  creditNumber     String    @map("credit_number")
  amount           Decimal   @db.Decimal(20, 6)
  remainingAmount  Decimal   @db.Decimal(20, 6) @map("remaining_amount")
  reason           String?
  expenseAccountId String    @map("expense_account_id")
  journalEntryId   String?   @unique @map("journal_entry_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor           Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@unique([organizationId, creditNumber])
  @@map("vendor_credits")
}

/// Employee/contractor out-of-pocket expense reimbursement request.
model Reimbursement {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id")
  employeeId       String?   @map("employee_id")
  payeeName        String    @map("payee_name")
  amount           Decimal   @db.Decimal(20, 6)
  description      String?
  expenseAccountId String    @map("expense_account_id")
  paymentAccountId String?   @map("payment_account_id")
  status           String    @default("pending")
  journalEntryId   String?   @unique @map("journal_entry_id")
  requestedByUserId String   @map("requested_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines            ReimbursementLine[]

  @@map("reimbursements")
}

/// Physical/warehouse location for multi-location inventory tracking.
model Location {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  address        String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@map("locations")
}

/// Staff allocation: which users are assigned to a project and at what
/// percentage of their time, used for job-costing/staffing reports.
model ProjectAssignment {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id")
  projectId         String    @map("project_id")
  userId            String    @map("user_id")
  allocationPercent Decimal   @default(100) @db.Decimal(5, 2) @map("allocation_percent")
  roleLabel         String?   @map("role_label")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_assignments")
}

/// One-time donation received (nonprofit).
model Donation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  donorName      String    @map("donor_name")
  donorEmail     String?   @map("donor_email")
  amount         Decimal   @db.Decimal(20, 6)
  date           DateTime
  fundId         String?   @map("fund_id")
  method         String?
  depositAccountId String  @map("deposit_account_id")
  journalEntryId String?   @unique @map("journal_entry_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fund           Fund?        @relation(fields: [fundId], references: [id], onDelete: SetNull)

  @@map("donations")
}

/// A donor's committed future gift (nonprofit); fulfilledAmount tracks
/// progress as matching Donations are recorded against it.
model Pledge {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id")
  donorName        String    @map("donor_name")
  donorEmail       String?   @map("donor_email")
  amount           Decimal   @db.Decimal(20, 6)
  pledgeDate       DateTime  @map("pledge_date")
  dueDate          DateTime? @map("due_date")
  fulfilledAmount  Decimal   @default(0) @db.Decimal(20, 6) @map("fulfilled_amount")
  fundId           String?   @map("fund_id")
  status           String    @default("open")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fund             Fund?        @relation(fields: [fundId], references: [id], onDelete: SetNull)

  @@map("pledges")
}

/// Organization-defined custom field on a given entity type (e.g.
/// "customer", "invoice"). Values are stored separately so fields can be
/// added/removed without a schema migration per field.
model CustomField {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  entityType     String    @map("entity_type")
  name           String
  fieldType      String    @default("text") @map("field_type")
  options        String[]  @default([])
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values         CustomFieldValue[]

  @@unique([organizationId, entityType, name])
  @@map("custom_fields")
}

model CustomFieldValue {
  id            String      @id @default(uuid()) @db.Uuid
  customFieldId String      @map("custom_field_id")
  entityId      String      @map("entity_id")
  value         String?
  createdAt     DateTime    @default(now()) @map("created_at")

  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, entityId])
  @@map("custom_field_values")
}

/// Simple "when X, do Y" automation rule. Evaluated on demand via
/// POST /api/workflows/run-due (no background scheduler exists yet).
model WorkflowRule {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  triggerType    String    @map("trigger_type")
  triggerConfig  Json?     @map("trigger_config")
  actionType     String    @default("notify") @map("action_type")
  active         Boolean   @default(true)
  lastRunAt      DateTime? @map("last_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("workflow_rules")
}

/// User-defined KPI: a labeled sum/average over a set of account balances,
/// surfaced on the executive dashboard.
model KpiDefinition {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  accountIds     String[]  @default([]) @map("account_ids")
  operation      String    @default("sum")
  targetValue    Decimal?  @db.Decimal(20, 6) @map("target_value")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("kpi_definitions")
}

/// A "what-if" budget scenario: percentage adjustments applied to an
/// existing budget/actuals baseline for side-by-side comparison.
model BudgetScenario {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  basedOnActual  Boolean   @default(false) @map("based_on_actual")
  adjustments    Json
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("budget_scenarios")
}

/// In-app support ticket. Priority/response-time expectations are derived
/// from the organization's plan (see src/lib/support.ts) — there is no
/// live chat or ticketing-system integration.
model SupportTicket {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  createdByUserId String   @map("created_by_user_id")
  subject        String
  message        String
  status         String    @default("open")
  priority       String    @default("standard")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

/// Durable background job queue. Recurring templates, workflow rules,
/// webhook deliveries and outbound emails all enqueue work here instead of
/// executing inline, so retries/backoff/failure visibility are consistent.
/// Processing happens when POST /api/jobs/process is called (see
/// docs/deployment.md for wiring an external scheduler/cron to that
/// endpoint) — there is no in-process timer, matching the rest of
/// Lumviq's "no hidden background magic" posture.
model BackgroundJob {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id")
  type           String
  payload        Json
  status         String    @default("pending")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  runAt          DateTime  @default(now()) @map("run_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@map("background_jobs")
}

/// Record of every outbound email Lumviq attempted to send. When no
/// provider is configured (see src/lib/integrations/email.ts) the email is
/// only logged here, never actually delivered — status stays "logged_only".
model EmailLog {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id")
  toAddress      String    @map("to_address")
  subject        String
  body           String
  provider       String
  status         String    @default("logged_only")
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("email_logs")
}

/// Reconciliation of any general-ledger balance-sheet account against an
/// external statement/subledger figure (distinct from bank-feed
/// ReconciliationSession, which only covers bank/credit-card accounts).
model AccountReconciliation {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id")
  accountId         String    @map("account_id")
  periodEndDate     DateTime  @map("period_end_date")
  statementBalance  Decimal   @db.Decimal(20, 6) @map("statement_balance")
  glBalance         Decimal   @db.Decimal(20, 6) @map("gl_balance")
  status            String    @default("in_progress")
  notes             String?
  reconciledByUserId String?  @map("reconciled_by_user_id")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account           Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clearedLines      JournalLine[] @relation("JournalLineAccountReconciliation")

  @@map("account_reconciliations")
}

/// A single task on an accounting period's close checklist (e.g. "Reconcile
/// operating bank account", "Post depreciation", "Review AR aging").
model CloseChecklistItem {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id")
  accountingPeriodId String    @map("accounting_period_id")
  label              String
  status             String    @default("pending")
  assignedToUserId   String?   @map("assigned_to_user_id")
  notes              String?
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountingPeriod   AccountingPeriod @relation(fields: [accountingPeriodId], references: [id], onDelete: Cascade)

  @@map("close_checklist_items")
}

/// Fixed asset register entry. Depreciation is straight-line only —
/// see docs/known-limitations.md for other methods not yet supported.
model FixedAsset {
  id                          String    @id @default(uuid()) @db.Uuid
  organizationId              String    @map("organization_id")
  name                        String
  assetAccountId              String    @map("asset_account_id")
  depreciationExpenseAccountId String   @map("depreciation_expense_account_id")
  accumulatedDepreciationAccountId String @map("accumulated_depreciation_account_id")
  acquisitionDate             DateTime  @map("acquisition_date")
  cost                        Decimal   @db.Decimal(20, 6)
  salvageValue                Decimal   @default(0) @db.Decimal(20, 6) @map("salvage_value")
  usefulLifeMonths            Int       @map("useful_life_months")
  method                      String    @default("straight_line")
  disposedAt                  DateTime? @map("disposed_at")
  disposalAmount              Decimal?  @db.Decimal(20, 6) @map("disposal_amount")
  createdAt                   DateTime  @default(now()) @map("created_at")

  organization                Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  depreciationEntries         DepreciationEntry[]

  @@map("fixed_assets")
}

model DepreciationEntry {
  id             String    @id @default(uuid()) @db.Uuid
  fixedAssetId   String    @map("fixed_asset_id")
  periodDate     DateTime  @map("period_date")
  amount         Decimal   @db.Decimal(20, 6)
  journalEntryId String?   @unique @map("journal_entry_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  fixedAsset     FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)

  @@unique([fixedAssetId, periodDate])
  @@map("depreciation_entries")
}

/// Loan/debt register with an amortization schedule. Interest/principal
/// split uses a standard amortizing-loan formula.
model Loan {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @map("organization_id")
  name                   String
  lenderName             String?   @map("lender_name")
  liabilityAccountId     String    @map("liability_account_id")
  interestExpenseAccountId String  @map("interest_expense_account_id")
  disbursementAccountId  String?   @map("disbursement_account_id")
  principal              Decimal   @db.Decimal(20, 6)
  interestRatePercent    Decimal   @db.Decimal(8, 4) @map("interest_rate_percent")
  termMonths             Int       @map("term_months")
  startDate              DateTime  @map("start_date")
  createdAt              DateTime  @default(now()) @map("created_at")

  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments               LoanPayment[]

  @@map("loans")
}

model LoanPayment {
  id               String    @id @default(uuid()) @db.Uuid
  loanId           String    @map("loan_id")
  paymentDate      DateTime  @map("payment_date")
  amount           Decimal   @db.Decimal(20, 6)
  principalPortion Decimal   @db.Decimal(20, 6) @map("principal_portion")
  interestPortion  Decimal   @db.Decimal(20, 6) @map("interest_portion")
  journalEntryId   String?   @unique @map("journal_entry_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  loan             Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, paymentDate])
  @@map("loan_payments")
}

/// Multi-line item on a Reimbursement, enabling full "expense report"
/// style submissions (several expenses, one reimbursement request).
/// When lines exist, Reimbursement.amount is kept as their sum.
model ReimbursementLine {
  id               String    @id @default(uuid()) @db.Uuid
  reimbursementId  String    @map("reimbursement_id")
  date             DateTime
  description      String
  amount           Decimal   @db.Decimal(20, 6)
  expenseAccountId String    @map("expense_account_id")
  documentId       String?   @map("document_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  reimbursement    Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  @@map("reimbursement_lines")
}

/// Goods receipt against a PurchaseOrder, enabling 3-way matching
/// (purchase order vs. receipt vs. bill) before a bill is paid.
model PurchaseOrderReceipt {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id")
  purchaseOrderId String    @map("purchase_order_id")
  receivedDate    DateTime  @map("received_date")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lines           PurchaseOrderReceiptLine[]

  @@map("purchase_order_receipts")
}

model PurchaseOrderReceiptLine {
  id                      String    @id @default(uuid()) @db.Uuid
  purchaseOrderReceiptId  String    @map("purchase_order_receipt_id")
  purchaseOrderLineId     String    @map("purchase_order_line_id")
  quantityReceived        Decimal   @db.Decimal(20, 6) @map("quantity_received")

  purchaseOrderReceipt    PurchaseOrderReceipt @relation(fields: [purchaseOrderReceiptId], references: [id], onDelete: Cascade)

  @@map("purchase_order_receipt_lines")
}

/// Time-limited guest-access token letting a customer view/pay a single
/// invoice without a Lumviq account (customer portal).
model InvoicePortalToken {
  id             String    @id @default(uuid()) @db.Uuid
  invoiceId      String    @map("invoice_id")
  token          String    @unique
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("invoice_portal_tokens")
}

/// Time-limited guest-access token letting a vendor upload a bill/receipt
/// for an organization without a Lumviq account (vendor portal).
model VendorUploadToken {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  vendorId       String    @map("vendor_id")
  token          String    @unique
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_upload_tokens")
}

/// Intercompany transaction between two linked organizations (parent/child
/// per Organization.parentOrganizationId). Posts a due-to/due-from journal
/// entry on each side and can be marked eliminated for consolidated
/// reporting (see src/lib/consolidation.ts).
model IntercompanyTransaction {
  id                       String    @id @default(uuid()) @db.Uuid
  organizationId           String    @map("organization_id")
  counterpartyOrganizationId String  @map("counterparty_organization_id")
  description              String?
  amount                   Decimal   @db.Decimal(20, 6)
  dueToAccountId           String    @map("due_to_account_id")
  dueFromAccountId         String    @map("due_from_account_id")
  journalEntryId           String?   @unique @map("journal_entry_id")
  counterpartyJournalEntryId String? @unique @map("counterparty_journal_entry_id")
  eliminated               Boolean   @default(false)
  createdAt                DateTime  @default(now()) @map("created_at")

  organization             Organization @relation("IntercompanyOwner", fields: [organizationId], references: [id], onDelete: Cascade)
  counterpartyOrganization Organization @relation("IntercompanyCounterparty", fields: [counterpartyOrganizationId], references: [id], onDelete: Cascade)

  @@map("intercompany_transactions")
}


