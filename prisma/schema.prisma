  firstName          String   @map("first_name")
  lastName           String   @map("last_name")
  email              String
  phone              String?
  organizationName   String   @map("organization_name")
  organizationType   String?  @map("organization_type")
  employeeCount      String?  @map("employee_count")
  currentSystem      String?  @map("current_system")
  requiredModules    String[] @default([]) @map("required_modules")
  preferredContact   String?  @map("preferred_contact")
  message             String?
  consentAcknowledged Boolean @default(false) @map("consent_acknowledged")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("contact_sales_submissions")
}

/// Uploaded file metadata (receipts, attachments) linked to any record via
/// relatedType/relatedId. Files are stored on local disk under /uploads in
/// development; see src/lib/documents.ts — no cloud storage provider is
/// configured, so this is not yet durable/production storage.
model Document {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id")
  fileName         String    @map("file_name")
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  storagePath      String    @map("storage_path")
  relatedType      String?   @map("related_type")
  relatedId        String?   @map("related_id")
  uploadedByUserId String?   @map("uploaded_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("documents")
}

/// In-app notifications. userId null = organization-wide notification.
model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  userId         String?   @map("user_id")
  type           String
  title          String
  message        String
  link           String?
  read           Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

/// Pending sign-off on a sensitive action (bill/expense/payment/journal
/// entry over a configured threshold). Approve/reject before the source
/// record may be posted — see src/lib/approvals.ts.
model Approval {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id")
  resourceType      String    @map("resource_type")
  resourceId        String    @map("resource_id")
  status            String    @default("pending")
  amount            Decimal?  @db.Decimal(20, 6)
  /// Parameters needed to execute the pending action once approved (e.g. a
  /// bill payment's amount/paymentDate/method/paymentAccountId). Nothing is
  /// posted to the ledger until an approval with a payload is approved.
  payload           Json?
  note              String?
  requestedByUserId String    @map("requested_by_user_id")
  decidedByUserId   String?   @map("decided_by_user_id")
  decidedAt         DateTime? @map("decided_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("approvals")
}

model ImportJob {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id")
  entityType      String    @map("entity_type")
  status          String    @default("pending")
  dryRun          Boolean   @default(true) @map("dry_run")
  fileName        String?   @map("file_name")
  totalRows       Int       @default(0) @map("total_rows")
  successRows     Int       @default(0) @map("success_rows")
  errorRows       Int       @default(0) @map("error_rows")
  errors          Json?
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("import_jobs")
}

model ExportJob {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id")
  entityType      String    @map("entity_type")
  status          String    @default("pending")
  rowCount        Int       @default(0) @map("row_count")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("export_jobs")
}

/// Nonprofit fund accounting: a fund groups restricted/unrestricted money.
model Fund {
