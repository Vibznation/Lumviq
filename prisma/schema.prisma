generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String                 @id @default(uuid()) @db.Uuid
  email         String                 @unique
  name          String?
  passwordHash  String?                @map("password_hash")
  emailVerified Boolean                @default(false) @map("email_verified")
  mfaEnabled    Boolean                @default(false) @map("mfa_enabled")
  passkeyRegistered Boolean            @default(false) @map("passkey_registered")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  memberships   OrganizationMembership[]

  @@map("users")
}

model Organization {
  id             String                  @id @default(uuid()) @db.Uuid
  name           String
  orgType        String?                 @default("business") @map("org_type")
  industry       String?
  parentOrganizationId String?           @map("parent_organization_id") @db.Uuid
  planId         String                  @default("free") @map("plan_id")
  billingCycle   String                  @default("monthly") @map("billing_cycle")
  addOns         String[]                @default([]) @map("add_ons")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  memberships    OrganizationMembership[]
  accounts       Account[]
  journalEntries JournalEntry[]
  fiscalYears    FiscalYear[]
  invitations    OrganizationInvitation[]
  bankAccounts   BankAccount[]
  sessions       ReconciliationSession[]
  customers      Customer[]
  invoices       Invoice[]
  invoicePayments InvoicePayment[]
  vendors        Vendor[]
  bills          Bill[]
  billPayments   BillPayment[]
  taxRates       TaxRate[]
  products       Product[]
  stockMovements StockMovement[]
  projects       Project[]
  timeEntries    TimeEntry[]
  budgets        Budget[]
  employees      Employee[]
  payRuns        PayRun[]
  subscriptionEvents SubscriptionEvent[]
  documents      Document[]
  notifications  Notification[]
  approvals      Approval[]
  importJobs     ImportJob[]
  exportJobs     ExportJob[]
  funds          Fund[]
  grants         Grant[]
  programs       Program[]
  exchangeRates  ExchangeRate[]
  dimensions     Dimension[]
  contractors    Contractor[]
  aiInteractions AiInteraction[]
  webhooks       Webhook[]

  parentOrganization   Organization?  @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  childOrganizations   Organization[] @relation("OrganizationHierarchy")

  @@map("organizations")
}

model OrganizationMembership {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id")
  organizationId String      @map("organization_id")
  role           String
  roleId         String?     @map("role_id")
  createdAt      DateTime    @default(now()) @map("created_at")

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleRef        Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@map("organization_memberships")
}

model Role {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @unique
  description String?
  memberships OrganizationMembership[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @unique
  description String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Account {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id")
  code           String
  name           String
  type           String
  subtype        String?
  createdAt      DateTime      @default(now()) @map("created_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalLines   JournalLine[]
  invoiceLines   InvoiceLine[]
  billLines      BillLine[]
  budgets        Budget[]

  @@map("accounts")
}

model JournalEntry {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id")
  description    String?
  posted         Boolean       @default(false)
  postedAt       DateTime?     @map("posted_at")
  postingUserId  String?       @map("posting_user_id")
  idempotencyKey String?       @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id            String       @id @default(uuid()) @db.Uuid
  journalEntryId String      @map("journal_entry_id")
  accountId     String       @map("account_id")
  description   String?
  amount        Decimal      @db.Decimal(20, 6)
  isDebit       Boolean      @map("is_debit")
  dimensionValueId String?   @map("dimension_value_id")

  journalEntry  JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  dimensionValue DimensionValue? @relation(fields: [dimensionValueId], references: [id], onDelete: SetNull)

  @@map("journal_lines")
}

model FiscalYear {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id")
  startDate      DateTime          @map("start_date")
  endDate        DateTime          @map("end_date")
  createdAt      DateTime          @default(now()) @map("created_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountingPeriods AccountingPeriod[]

  @@map("fiscal_years")
}

model AccountingPeriod {
  id             String      @id @default(uuid()) @db.Uuid
  fiscalYearId   String      @map("fiscal_year_id")
  startDate      DateTime    @map("start_date")
  endDate        DateTime    @map("end_date")
  isClosed       Boolean     @default(false) @map("is_closed")

  fiscalYear     FiscalYear  @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@map("accounting_periods")
}

model AuditEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id")
  actorId        String?   @map("actor_id")
  action         String
  resourceType   String    @map("resource_type")
  resourceId     String    @map("resource_id")
  previousState  Json?     @map("previous_state")
  newState       Json?     @map("new_state")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("audit_events")
}

model OrganizationInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id")
  email          String
  token          String       @unique
  role           String
  createdAt      DateTime     @default(now()) @map("created_at")
  expiresAt      DateTime?    @map("expires_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_invitations")
}

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  email          String?
  phone          String?
  billingAddress String?   @map("billing_address")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]

  @@map("customers")
}

model Invoice {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id")
  customerId     String            @map("customer_id")
  projectId      String?           @map("project_id")
  invoiceNumber  String            @map("invoice_number")
  status         String            @default("draft")
  issueDate      DateTime          @map("issue_date")
  dueDate        DateTime          @map("due_date")
  currency       String            @default("USD")
  subtotal       Decimal           @db.Decimal(20, 6)
  taxRateId      String?           @map("tax_rate_id")
  taxTotal       Decimal           @default(0) @db.Decimal(20, 6) @map("tax_total")
  total          Decimal           @db.Decimal(20, 6)
  amountPaid     Decimal           @default(0) @db.Decimal(20, 6) @map("amount_paid")
  journalEntryId String?           @unique @map("journal_entry_id")
  voidedAt       DateTime?         @map("voided_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  taxRate        TaxRate?          @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  lines          InvoiceLine[]
  payments       InvoicePayment[]

  @@unique([organizationId, invoiceNumber])
  @@map("invoices")
}

model InvoiceLine {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id")
  description String
  quantity    Decimal  @default(1) @db.Decimal(20, 6)
  unitPrice   Decimal  @db.Decimal(20, 6) @map("unit_price")
  amount      Decimal  @db.Decimal(20, 6)
  accountId   String   @map("account_id")
  productId   String?  @map("product_id")
  createdAt   DateTime @default(now()) @map("created_at")

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("invoice_lines")
}

model InvoicePayment {
  id             String    @id @default(uuid()) @db.Uuid
  invoiceId      String    @map("invoice_id")
  organizationId String    @map("organization_id")
  amount         Decimal   @db.Decimal(20, 6)
  paymentDate    DateTime  @map("payment_date")
  method         String?
  depositAccountId String  @map("deposit_account_id")
  journalEntryId String?   @unique @map("journal_entry_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invoice_payments")
}

model BankAccount {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id")
  provider       String?
  name           String
  accountNumber  String?               @map("account_number")
  currency       String?
  createdAt      DateTime              @default(now()) @map("created_at")

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   BankTransaction[]     @relation("BankAccountTransactions")
  reconciliationSessions ReconciliationSession[] @relation("BankAccountReconciliationSessions")

  @@map("bank_accounts")
}

model BankTransaction {
  id             String                 @id @default(uuid()) @db.Uuid
  bankAccountId  String                 @map("bank_account_id")
  importedAt     DateTime               @default(now()) @map("imported_at")
  transactionDate DateTime              @map("transaction_date")
  amount         Decimal                @db.Decimal(20, 6)
  description    String?
  externalId     String?                @map("external_id")
  importedFile   String?                @map("imported_file")
  isCleared      Boolean                @default(false) @map("is_cleared")

  bankAccount    BankAccount            @relation(fields: [bankAccountId], references: [id], onDelete: Cascade, name: "BankAccountTransactions")
  reconciliationItems ReconciliationItem[] @relation("BankTransactionReconciliationItems")

  @@map("bank_transactions")
}

model ReconciliationSession {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id")
  bankAccountId  String                 @map("bank_account_id")
  startDate      DateTime               @map("start_date")
  endDate        DateTime               @map("end_date")
  status         String                 @default("open")
  createdAt      DateTime               @default(now()) @map("created_at")
  closedAt       DateTime?              @map("closed_at")

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount    BankAccount            @relation(fields: [bankAccountId], references: [id], onDelete: Cascade, name: "BankAccountReconciliationSessions")
  items          ReconciliationItem[]   @relation("ReconciliationSessionItems")

  @@map("reconciliation_sessions")
}

model ReconciliationItem {
  id                  String               @id @default(uuid()) @db.Uuid
  sessionId           String               @map("session_id")
  bankTransactionId   String               @map("bank_transaction_id")
  matched             Boolean              @default(false)
  matchedToJournalLineId String?            @map("matched_to_journal_line_id")

  session             ReconciliationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, name: "ReconciliationSessionItems")
  bankTransaction     BankTransaction      @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade, name: "BankTransactionReconciliationItems")

  @@unique([bankTransactionId])
  @@map("reconciliation_items")
}

model Vendor {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bills          Bill[]
  contractors    Contractor[]

  @@map("vendors")
}

model Bill {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id")
  vendorId       String       @map("vendor_id")
  billNumber     String       @map("bill_number")
  vendorReference String?     @map("vendor_reference")
  status         String       @default("draft")
  issueDate      DateTime     @map("issue_date")
  dueDate        DateTime     @map("due_date")
  currency       String       @default("USD")
  subtotal       Decimal      @db.Decimal(20, 6)
  taxRateId      String?      @map("tax_rate_id")
  taxTotal       Decimal      @default(0) @db.Decimal(20, 6) @map("tax_total")
  total          Decimal      @db.Decimal(20, 6)
  amountPaid     Decimal      @default(0) @db.Decimal(20, 6) @map("amount_paid")
  journalEntryId String?      @unique @map("journal_entry_id")
  voidedAt       DateTime?    @map("voided_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  taxRate        TaxRate?     @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  lines          BillLine[]
  payments       BillPayment[]

  @@unique([organizationId, billNumber])
  @@map("bills")
}

model BillLine {
  id          String   @id @default(uuid()) @db.Uuid
  billId      String   @map("bill_id")
  description String
  quantity    Decimal  @default(1) @db.Decimal(20, 6)
  unitPrice   Decimal  @db.Decimal(20, 6) @map("unit_price")
  amount      Decimal  @db.Decimal(20, 6)
  accountId   String   @map("account_id")
  productId   String?  @map("product_id")
  createdAt   DateTime @default(now()) @map("created_at")

  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("bill_lines")
}

model BillPayment {
  id             String       @id @default(uuid()) @db.Uuid
  billId         String       @map("bill_id")
  organizationId String       @map("organization_id")
  amount         Decimal      @db.Decimal(20, 6)
  paymentDate    DateTime     @map("payment_date")
  method         String?
  paymentAccountId String     @map("payment_account_id")
  journalEntryId String?      @unique @map("journal_entry_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  bill           Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("bill_payments")
}

model TaxRate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  rate           Decimal   @db.Decimal(9, 6)
  isDefault      Boolean   @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  bills          Bill[]

  @@map("tax_rates")
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  sku            String?
  name           String
  type           String    @default("service")
  salesPrice     Decimal?  @db.Decimal(20, 6) @map("sales_price")
  costPrice      Decimal?  @db.Decimal(20, 6) @map("cost_price")
  quantityOnHand Decimal   @default(0) @db.Decimal(20, 6) @map("quantity_on_hand")
  incomeAccountId String   @map("income_account_id")
  expenseAccountId String  @map("expense_account_id")
  inventoryAssetAccountId String? @map("inventory_asset_account_id")
  reorderPoint   Decimal?  @db.Decimal(20, 6) @map("reorder_point")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@map("products")
}

model StockMovement {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  productId      String    @map("product_id")
  type           String
  quantity       Decimal   @db.Decimal(20, 6)
  unitCost       Decimal   @db.Decimal(20, 6) @map("unit_cost")
  referenceType  String?   @map("reference_type")
  referenceId    String?   @map("reference_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

model Project {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  customerId     String?   @map("customer_id")
  name           String
  status         String    @default("active")
  budgetAmount   Decimal?  @db.Decimal(20, 6) @map("budget_amount")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timeEntries    TimeEntry[]

  @@map("projects")
}

model TimeEntry {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  projectId      String    @map("project_id")
  userId         String    @map("user_id")
  date           DateTime
  hours          Decimal   @db.Decimal(9, 2)
  billable       Boolean   @default(true)
  rate           Decimal?  @db.Decimal(20, 6)
  description    String?
  invoiced       Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("time_entries")
}

model Budget {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  accountId      String    @map("account_id")
  periodMonth    Int       @map("period_month")
  periodYear     Int       @map("period_year")
  amount         Decimal   @db.Decimal(20, 6)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([organizationId, accountId, periodMonth, periodYear])
  @@map("budgets")
}

model Employee {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  email          String?
  payType        String    @default("salary") @map("pay_type")
  rate           Decimal   @db.Decimal(20, 6)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payRunLines    PayRunLine[]

  @@map("employees")
}

model PayRun {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id")
  payPeriodStart   DateTime  @map("pay_period_start")
  payPeriodEnd     DateTime  @map("pay_period_end")
  status           String    @default("draft")
  totalGross       Decimal   @default(0) @db.Decimal(20, 6) @map("total_gross")
  totalEmployeeTax Decimal   @default(0) @db.Decimal(20, 6) @map("total_employee_tax")
  totalEmployerTax Decimal   @default(0) @db.Decimal(20, 6) @map("total_employer_tax")
  totalNetPay      Decimal   @default(0) @db.Decimal(20, 6) @map("total_net_pay")
  journalEntryId   String?   @unique @map("journal_entry_id")
  postedAt         DateTime? @map("posted_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          PayRunLine[]

  @@map("pay_runs")
}

model PayRunLine {
  id          String   @id @default(uuid()) @db.Uuid
  payRunId    String   @map("pay_run_id")
  employeeId  String   @map("employee_id")
  grossPay    Decimal  @db.Decimal(20, 6) @map("gross_pay")
  employeeTax Decimal  @default(0) @db.Decimal(20, 6) @map("employee_tax")
  netPay      Decimal  @default(0) @db.Decimal(20, 6) @map("net_pay")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  payRun      PayRun   @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@map("pay_run_lines")
}

/// Records every plan/billing-cycle/add-on change for an organization.
/// Plan and feature entitlements themselves are defined in src/lib/plans.ts,
/// not in the database — this table is only a change history/audit trail.
model SubscriptionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id")
  planId         String   @map("plan_id")
  billingCycle   String   @map("billing_cycle")
  addOns         String[] @default([]) @map("add_ons")
  actorId        String?  @map("actor_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscription_events")
}

/// Submissions from the public /contact-sales marketing form.
model ContactSalesSubmission {
  id                 String   @id @default(uuid()) @db.Uuid
  firstName          String   @map("first_name")
  lastName           String   @map("last_name")
  email              String
  phone              String?
  organizationName   String   @map("organization_name")
  organizationType   String?  @map("organization_type")
  employeeCount      String?  @map("employee_count")
  currentSystem      String?  @map("current_system")
  requiredModules    String[] @default([]) @map("required_modules")
  preferredContact   String?  @map("preferred_contact")
  message             String?
  consentAcknowledged Boolean @default(false) @map("consent_acknowledged")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("contact_sales_submissions")
}

/// Uploaded file metadata (receipts, attachments) linked to any record via
/// relatedType/relatedId. Files are stored on local disk under /uploads in
/// development; see src/lib/documents.ts — no cloud storage provider is
/// configured, so this is not yet durable/production storage.
model Document {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id")
  fileName         String    @map("file_name")
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  storagePath      String    @map("storage_path")
  relatedType      String?   @map("related_type")
  relatedId        String?   @map("related_id")
  uploadedByUserId String?   @map("uploaded_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("documents")
}

/// In-app notifications. userId null = organization-wide notification.
model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  userId         String?   @map("user_id")
  type           String
  title          String
  message        String
  link           String?
  read           Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

/// Pending sign-off on a sensitive action (bill/expense/payment/journal
/// entry over a configured threshold). Approve/reject before the source
/// record may be posted — see src/lib/approvals.ts.
model Approval {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id")
  resourceType      String    @map("resource_type")
  resourceId        String    @map("resource_id")
  status            String    @default("pending")
  amount            Decimal?  @db.Decimal(20, 6)
  /// Parameters needed to execute the pending action once approved (e.g. a
  /// bill payment's amount/paymentDate/method/paymentAccountId). Nothing is
  /// posted to the ledger until an approval with a payload is approved.
  payload           Json?
  note              String?
  requestedByUserId String    @map("requested_by_user_id")
  decidedByUserId   String?   @map("decided_by_user_id")
  decidedAt         DateTime? @map("decided_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("approvals")
}

model ImportJob {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id")
  entityType      String    @map("entity_type")
  status          String    @default("pending")
  dryRun          Boolean   @default(true) @map("dry_run")
  fileName        String?   @map("file_name")
  totalRows       Int       @default(0) @map("total_rows")
  successRows     Int       @default(0) @map("success_rows")
  errorRows       Int       @default(0) @map("error_rows")
  errors          Json?
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("import_jobs")
}

model ExportJob {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id")
  entityType      String    @map("entity_type")
  status          String    @default("pending")
  rowCount        Int       @default(0) @map("row_count")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("export_jobs")
}

/// Nonprofit fund accounting: a fund groups restricted/unrestricted money.
model Fund {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  type           String    @default("unrestricted")
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grants         Grant[]

  @@map("funds")
}

model Grant {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  fundId         String?   @map("fund_id")
  name           String
  grantorName    String    @map("grantor_name")
  totalAwarded   Decimal   @db.Decimal(20, 6) @map("total_awarded")
  amountSpent    Decimal   @default(0) @db.Decimal(20, 6) @map("amount_spent")
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fund           Fund?     @relation(fields: [fundId], references: [id], onDelete: SetNull)

  @@map("grants")
}

model Program {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("programs")
}

model ExchangeRate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  baseCurrency   String    @map("base_currency")
  quoteCurrency  String    @map("quote_currency")
  rate           Decimal   @db.Decimal(20, 8)
  asOfDate       DateTime  @map("as_of_date")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, baseCurrency, quoteCurrency, asOfDate])
  @@map("exchange_rates")
}

model Dimension {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values         DimensionValue[]

  @@unique([organizationId, name])
  @@map("dimensions")
}

model DimensionValue {
  id            String    @id @default(uuid()) @db.Uuid
  dimensionId   String    @map("dimension_id")
  name          String
  createdAt     DateTime  @default(now()) @map("created_at")

  dimension     Dimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  journalLines  JournalLine[]

  @@unique([dimensionId, name])
  @@map("dimension_values")
}

/// Lightweight 1099 contractor directory entry, optionally linked to a
/// Vendor record used for bill payments.
model Contractor {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  vendorId       String?   @map("vendor_id")
  name           String
  email          String?
  taxIdLast4     String?   @map("tax_id_last4")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@map("contractors")
}

/// Audit log of every Lumviq Intelligence computation, so insights are
/// traceable even though they are computed live and not stored elsewhere.
model AiInteraction {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  userId         String?   @map("user_id")
  kind           String
  basis          String?
  inputSummary   Json?     @map("input_summary")
  outputSummary  Json?     @map("output_summary")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ai_interactions")
}

/// Outbound webhook subscriptions for the public API (not yet exposed —
/// see src/lib/webhooks.ts).
model Webhook {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  url            String
  secret         String
  eventTypes     String[]  @default([]) @map("event_types")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id           String    @id @default(uuid()) @db.Uuid
  webhookId    String    @map("webhook_id")
  eventType    String    @map("event_type")
  payload      Json
  status       String    @default("pending")
  responseCode Int?      @map("response_code")
  attempt      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")

  webhook      Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}

