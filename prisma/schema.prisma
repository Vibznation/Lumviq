generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String                 @id @default(uuid()) @db.Uuid
  email         String                 @unique
  name          String?
  passwordHash  String?                @map("password_hash")
  emailVerified Boolean                @default(false) @map("email_verified")
  mfaEnabled    Boolean                @default(false) @map("mfa_enabled")
  passkeyRegistered Boolean            @default(false) @map("passkey_registered")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  memberships   OrganizationMembership[]

  @@map("users")
}

model Organization {
  id             String                  @id @default(uuid()) @db.Uuid
  name           String
  orgType        String?                 @default("business") @map("org_type")
  industry       String?
  parentOrganizationId String?           @map("parent_organization_id") @db.Uuid
  planId         String                  @default("free") @map("plan_id")
  billingCycle   String                  @default("monthly") @map("billing_cycle")
  addOns         String[]                @default([]) @map("add_ons")
  approvalThresholds Json?               @map("approval_thresholds")
  logoUrl        String?                 @map("logo_url")
  brandColor     String?                 @map("brand_color")
  idempotencyKey String?                 @unique @map("idempotency_key")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  memberships    OrganizationMembership[]
  accounts       Account[]
  journalEntries JournalEntry[]
  fiscalYears    FiscalYear[]
  invitations    OrganizationInvitation[]
  bankAccounts   BankAccount[]
  sessions       ReconciliationSession[]
  customers      Customer[]
  invoices       Invoice[]
  invoicePayments InvoicePayment[]
  vendors        Vendor[]
  bills          Bill[]
  billPayments   BillPayment[]
  taxRates       TaxRate[]
  products       Product[]
  creditNotes    CreditNote[]
  invoiceRefunds InvoiceRefund[]
  stockMovements StockMovement[]
  projects       Project[]
  timeEntries    TimeEntry[]
  budgets        Budget[]
  employees      Employee[]
  payRuns        PayRun[]
  subscriptionEvents SubscriptionEvent[]
  documents      Document[]
  notifications  Notification[]
  approvals      Approval[]
  importJobs     ImportJob[]
  exportJobs     ExportJob[]
  funds          Fund[]
  grants         Grant[]
  programs       Program[]
  exchangeRates  ExchangeRate[]
  dimensions     Dimension[]
  contractors    Contractor[]
  aiInteractions AiInteraction[]
  paySchedules         PaySchedule[]
  ptoPolicies          PtoPolicy[]
  taxFilings           TaxFiling[]
  payrollTaxDocuments  PayrollTaxDocument[]
  payrollProviderLinks PayrollProviderLink[]
  payrollWebhookEvents PayrollWebhookEvent[]
  directDepositAccounts DirectDepositAccount[]
  webhooks       Webhook[]
  estimates      Estimate[]
  purchaseOrders PurchaseOrder[]
  recurringTemplates RecurringTemplate[]
  vendorCredits  VendorCredit[]
  reimbursements Reimbursement[]
  locations      Location[]
  projectAssignments ProjectAssignment[]
  donations      Donation[]
  pledges        Pledge[]
  customFields   CustomField[]
  workflowRules  WorkflowRule[]
  kpiDefinitions KpiDefinition[]
  budgetScenarios BudgetScenario[]
  supportTickets SupportTicket[]
  accountReconciliations AccountReconciliation[]
  closeChecklistItems CloseChecklistItem[]
  fixedAssets    FixedAsset[]
  loans          Loan[]
  purchaseOrderReceipts PurchaseOrderReceipt[]
  vendorUploadTokens VendorUploadToken[]
  mileageLogs    MileageLog[]
  intercompanyOwned      IntercompanyTransaction[] @relation("IntercompanyOwner")
  intercompanyCounterparty IntercompanyTransaction[] @relation("IntercompanyCounterparty")
  roles          Role[]

  parentOrganization   Organization?  @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  childOrganizations   Organization[] @relation("OrganizationHierarchy")

  @@map("organizations")
}

model OrganizationMembership {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id")
  organizationId String      @map("organization_id")
  role           String
  roleId         String?     @map("role_id")
  createdAt      DateTime    @default(now()) @map("created_at")

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleRef        Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@map("organization_memberships")
}

model Role {
  id          String              @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name        String
  description String?
  memberships OrganizationMembership[]
  rolePermissions RolePermission[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @unique
  description String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Account {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id")
  code           String
  name           String
  type           String
  subtype        String?
  cashFlowCategory String?     @map("cash_flow_category")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalLines   JournalLine[]
  invoiceLines   InvoiceLine[]
  billLines      BillLine[]
  budgets        Budget[]
  accountReconciliations AccountReconciliation[]
  bankAccounts   BankAccount[]

  @@map("accounts")
}

model JournalEntry {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id")
  description    String?
  posted         Boolean       @default(false)
  postedAt       DateTime?     @map("posted_at")
  postingUserId  String?       @map("posting_user_id")
  idempotencyKey String?       @unique @map("idempotency_key")
  fundId         String?       @map("fund_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fund           Fund?         @relation(fields: [fundId], references: [id], onDelete: SetNull)
  lines          JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id            String       @id @default(uuid()) @db.Uuid
  journalEntryId String      @map("journal_entry_id")
  accountId     String       @map("account_id")
  description   String?
  amount        Decimal      @db.Decimal(20, 6)
  isDebit       Boolean      @map("is_debit")
  dimensionValueId String?   @map("dimension_value_id")
  accountReconciliationId String? @map("account_reconciliation_id")
  clearedAt     DateTime?    @map("cleared_at")

  journalEntry  JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  dimensionValue DimensionValue? @relation(fields: [dimensionValueId], references: [id], onDelete: SetNull)
  accountReconciliation AccountReconciliation? @relation("JournalLineAccountReconciliation", fields: [accountReconciliationId], references: [id], onDelete: SetNull)
  reconciliationMatches ReconciliationItem[]

  @@map("journal_lines")
}

model FiscalYear {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id")
  startDate      DateTime          @map("start_date")
  endDate        DateTime          @map("end_date")
  createdAt      DateTime          @default(now()) @map("created_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountingPeriods AccountingPeriod[]

  @@map("fiscal_years")
}

model AccountingPeriod {
  id             String      @id @default(uuid()) @db.Uuid
  fiscalYearId   String      @map("fiscal_year_id")
  startDate      DateTime    @map("start_date")
  endDate        DateTime    @map("end_date")
  isClosed       Boolean     @default(false) @map("is_closed")

  fiscalYear     FiscalYear  @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  closeChecklistItems CloseChecklistItem[]

  @@map("accounting_periods")
}

model AuditEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id")
  actorId        String?   @map("actor_id")
  action         String
  resourceType   String    @map("resource_type")
  resourceId     String    @map("resource_id")
  previousState  Json?     @map("previous_state")
  newState       Json?     @map("new_state")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("audit_events")
}

model OrganizationInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id")
  email          String
  token          String       @unique
  role           String
  createdAt      DateTime     @default(now()) @map("created_at")
  expiresAt      DateTime?    @map("expires_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_invitations")
}

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  email          String?
  phone          String?
  billingAddress String?   @map("billing_address")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  estimates      Estimate[]
  creditNotes    CreditNote[]

  @@map("customers")
}

/// Credit memo issued to a customer, reducing what they owe (or owed to them via refund).
model CreditNote {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id")
  customerId      String    @map("customer_id")
  creditNumber    String    @map("credit_number")
  amount          Decimal   @db.Decimal(20, 6)
  remainingAmount Decimal   @db.Decimal(20, 6) @map("remaining_amount")
  reason          String?
  incomeAccountId String    @map("income_account_id")
  journalEntryId  String?   @unique @map("journal_entry_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([organizationId, creditNumber])
  @@map("credit_notes")
}

/// A cash refund issued to a customer against a specific invoice (e.g. an overpayment or a returned sale).
model InvoiceRefund {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id")
  invoiceId        String    @map("invoice_id")
  amount           Decimal   @db.Decimal(20, 6)
  refundDate       DateTime  @map("refund_date")
  reason           String?
  depositAccountId String    @map("deposit_account_id")
  journalEntryId   String?   @unique @map("journal_entry_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice          Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@map("invoice_refunds")
}

model Invoice {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id")
  customerId     String            @map("customer_id")
  projectId      String?           @map("project_id")
  invoiceNumber  String            @map("invoice_number")
  status         String            @default("draft")
  issueDate      DateTime          @map("issue_date")
  dueDate        DateTime          @map("due_date")
  currency       String            @default("USD")
  subtotal       Decimal           @db.Decimal(20, 6)
  taxRateId      String?           @map("tax_rate_id")
  taxTotal       Decimal           @default(0) @db.Decimal(20, 6) @map("tax_total")
  total          Decimal           @db.Decimal(20, 6)
  amountPaid     Decimal           @default(0) @db.Decimal(20, 6) @map("amount_paid")
  paymentTerms   String?           @map("payment_terms")
  journalEntryId String?           @unique @map("journal_entry_id")
  voidedAt       DateTime?         @map("voided_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  taxRate        TaxRate?          @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  lines          InvoiceLine[]
  payments       InvoicePayment[]
  refunds        InvoiceRefund[]

  @@unique([organizationId, invoiceNumber])
  @@map("invoices")
}

model InvoiceLine {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id")
  description String
  quantity    Decimal  @default(1) @db.Decimal(20, 6)
  unitPrice   Decimal  @db.Decimal(20, 6) @map("unit_price")
  discount    Decimal  @default(0) @db.Decimal(20, 6)
  amount      Decimal  @db.Decimal(20, 6)
  accountId   String   @map("account_id")
  productId   String?  @map("product_id")
  createdAt   DateTime @default(now()) @map("created_at")

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("invoice_lines")
}

model InvoicePayment {
  id             String    @id @default(uuid()) @db.Uuid
  invoiceId      String    @map("invoice_id")
  organizationId String    @map("organization_id")
  amount         Decimal   @db.Decimal(20, 6)
  paymentDate    DateTime  @map("payment_date")
  method         String?
  depositAccountId String  @map("deposit_account_id")
  journalEntryId String?   @unique @map("journal_entry_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invoice_payments")
}

model BankAccount {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id")
  accountId      String?               @map("account_id")
  provider       String?
  name           String
  accountNumber  String?               @map("account_number")
  currency       String?
  createdAt      DateTime              @default(now()) @map("created_at")

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactions   BankTransaction[]     @relation("BankAccountTransactions")
  reconciliationSessions ReconciliationSession[] @relation("BankAccountReconciliationSessions")

  @@map("bank_accounts")
}

model BankTransaction {
  id             String                 @id @default(uuid()) @db.Uuid
  bankAccountId  String                 @map("bank_account_id")
  importedAt     DateTime               @default(now()) @map("imported_at")
  transactionDate DateTime              @map("transaction_date")
  amount         Decimal                @db.Decimal(20, 6)
  description    String?
  externalId     String?                @map("external_id")
  importedFile   String?                @map("imported_file")
  isCleared      Boolean                @default(false) @map("is_cleared")

  bankAccount    BankAccount            @relation(fields: [bankAccountId], references: [id], onDelete: Cascade, name: "BankAccountTransactions")
  reconciliationItems ReconciliationItem[] @relation("BankTransactionReconciliationItems")

  @@map("bank_transactions")
}

model ReconciliationSession {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id")
  bankAccountId  String                 @map("bank_account_id")
  startDate      DateTime               @map("start_date")
  endDate        DateTime               @map("end_date")
  status         String                 @default("open")
  statementEndingBalance Decimal?       @map("statement_ending_balance") @db.Decimal(20, 6)
  createdAt      DateTime               @default(now()) @map("created_at")
  closedAt       DateTime?              @map("closed_at")

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount    BankAccount            @relation(fields: [bankAccountId], references: [id], onDelete: Cascade, name: "BankAccountReconciliationSessions")
  items          ReconciliationItem[]   @relation("ReconciliationSessionItems")

  @@map("reconciliation_sessions")
}

model ReconciliationItem {
  id                  String               @id @default(uuid()) @db.Uuid
  sessionId           String               @map("session_id")
  bankTransactionId   String               @map("bank_transaction_id")
  matched             Boolean              @default(false)
  matchedToJournalLineId String?            @map("matched_to_journal_line_id")

  session             ReconciliationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, name: "ReconciliationSessionItems")
  bankTransaction     BankTransaction      @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade, name: "BankTransactionReconciliationItems")
  matchedToJournalLine JournalLine?        @relation(fields: [matchedToJournalLineId], references: [id], onDelete: SetNull)

  @@unique([bankTransactionId])
  @@map("reconciliation_items")
}

model Vendor {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  email          String?
  phone          String?
  address        String?
  paymentTerms   String?   @map("payment_terms")
  taxId          String?   @map("tax_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bills          Bill[]
  contractors    Contractor[]
  purchaseOrders PurchaseOrder[]
  vendorCredits  VendorCredit[]
  uploadTokens   VendorUploadToken[]

  @@map("vendors")
}

model Bill {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id")
  vendorId       String       @map("vendor_id")
  billNumber     String       @map("bill_number")
  vendorReference String?     @map("vendor_reference")
  status         String       @default("draft")
  issueDate      DateTime     @map("issue_date")
  dueDate        DateTime     @map("due_date")
  currency       String       @default("USD")
  subtotal       Decimal      @db.Decimal(20, 6)
  taxRateId      String?      @map("tax_rate_id")
  taxTotal       Decimal      @default(0) @db.Decimal(20, 6) @map("tax_total")
  total          Decimal      @db.Decimal(20, 6)
  amountPaid     Decimal      @default(0) @db.Decimal(20, 6) @map("amount_paid")
  journalEntryId String?      @unique @map("journal_entry_id")
  voidedAt       DateTime?    @map("voided_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  taxRate        TaxRate?     @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  lines          BillLine[]
  payments       BillPayment[]

  @@unique([organizationId, billNumber])
  @@map("bills")
}

model BillLine {
  id          String   @id @default(uuid()) @db.Uuid
  billId      String   @map("bill_id")
  description String
  quantity    Decimal  @default(1) @db.Decimal(20, 6)
  unitPrice   Decimal  @db.Decimal(20, 6) @map("unit_price")
  amount      Decimal  @db.Decimal(20, 6)
  accountId   String   @map("account_id")
  productId   String?  @map("product_id")
  createdAt   DateTime @default(now()) @map("created_at")

  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("bill_lines")
}

model BillPayment {
  id             String       @id @default(uuid()) @db.Uuid
  billId         String       @map("bill_id")
  organizationId String       @map("organization_id")
  amount         Decimal      @db.Decimal(20, 6)
  paymentDate    DateTime     @map("payment_date")
  method         String?
  paymentAccountId String     @map("payment_account_id")
  journalEntryId String?      @unique @map("journal_entry_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  bill           Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("bill_payments")
}

model TaxRate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  rate           Decimal   @db.Decimal(9, 6)
  isDefault      Boolean   @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  bills          Bill[]

  @@map("tax_rates")
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  sku            String?
  name           String
  type           String    @default("service")
  salesPrice     Decimal?  @db.Decimal(20, 6) @map("sales_price")
  costPrice      Decimal?  @db.Decimal(20, 6) @map("cost_price")
  quantityOnHand Decimal   @default(0) @db.Decimal(20, 6) @map("quantity_on_hand")
  incomeAccountId String   @map("income_account_id")
  expenseAccountId String  @map("expense_account_id")
  inventoryAssetAccountId String? @map("inventory_asset_account_id")
  reorderPoint   Decimal?  @db.Decimal(20, 6) @map("reorder_point")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@map("products")
}

model StockMovement {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  productId      String    @map("product_id")
  locationId     String?   @map("location_id")
  type           String
  quantity       Decimal   @db.Decimal(20, 6)
  unitCost       Decimal   @db.Decimal(20, 6) @map("unit_cost")
  referenceType  String?   @map("reference_type")
  referenceId    String?   @map("reference_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@map("stock_movements")
}

model Project {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  customerId     String?   @map("customer_id")
  name           String
  status         String    @default("active")
  budgetAmount   Decimal?  @db.Decimal(20, 6) @map("budget_amount")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timeEntries    TimeEntry[]
  assignments    ProjectAssignment[]
  payRunLines    PayRunLine[]

  @@map("projects")
}

model TimeEntry {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  projectId      String    @map("project_id")
  userId         String    @map("user_id")
  date           DateTime
  hours          Decimal   @db.Decimal(9, 2)
  billable       Boolean   @default(true)
  rate           Decimal?  @db.Decimal(20, 6)
  description    String?
  invoiced       Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("time_entries")
}

model Budget {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  accountId      String    @map("account_id")
  periodMonth    Int       @map("period_month")
  periodYear     Int       @map("period_year")
  amount         Decimal   @db.Decimal(20, 6)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([organizationId, accountId, periodMonth, periodYear])
  @@map("budgets")
}

/// Employee master record. Extended in place (Definition of Done, full
/// payroll spec) with onboarding/personal/tax/organizational fields — the
/// original salary/hourly fields (payType, rate) are unchanged so existing
/// pay runs keep working. SSN is never stored in plaintext: ssnEncrypted
/// holds an AES-256-GCM ciphertext (src/lib/encryption.ts) and only
/// ssnLast4 is ever surfaced through the API.
model Employee {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @map("organization_id")
  userId                String?   @map("user_id")
  name                  String
  preferredName         String?   @map("preferred_name")
  email                 String?
  phone                 String?
  addressLine1          String?   @map("address_line1")
  addressLine2          String?   @map("address_line2")
  city                  String?
  state                 String?
  postalCode            String?   @map("postal_code")
  dateOfBirth           DateTime? @map("date_of_birth")
  ssnEncrypted          String?   @map("ssn_encrypted")
  ssnLast4              String?   @map("ssn_last4")
  payType               String    @default("salary") @map("pay_type")
  rate                  Decimal   @db.Decimal(20, 6)
  overtimeEligible      Boolean   @default(true) @map("overtime_eligible")
  /// 'active' | 'on_leave' | 'terminated'
  employmentStatus      String    @default("active") @map("employment_status")
  hireDate              DateTime? @map("hire_date")
  terminationDate       DateTime? @map("termination_date")
  department            String?
  jobTitle              String?   @map("job_title")
  managerId             String?   @map("manager_id")
  locationId            String?   @map("location_id")
  payScheduleId         String?   @map("pay_schedule_id")
  /// 'not_started' | 'information_required' | 'verification_pending' | 'ready' | 'complete'
  onboardingStatus      String    @default("not_started") @map("onboarding_status")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  providerEmployeeId    String?   @map("provider_employee_id")
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager        Employee?    @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports        Employee[]   @relation("EmployeeManager")
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  paySchedule    PaySchedule? @relation(fields: [payScheduleId], references: [id], onDelete: SetNull)
  payRunLines    PayRunLine[]
  taxProfile     EmployeeTaxProfile?
  directDeposits DirectDepositAccount[]
  deductions     Deduction[]
  garnishments   Garnishment[]
  ptoBalances    PtoBalance[]
  ptoRequests    PtoRequest[]

  @@map("employees")
}

/// Extended in place for the full payroll-run workflow. status now moves
/// through: draft, calculating, calculated, needs_attention,
/// awaiting_approval, approved, submitted, processing,
/// partially_processed, paid, completed, failed, cancelled, voided,
/// reversed — see src/lib/payroll-run.ts for the state machine. Existing
/// draft/posted-era rows remain valid ('posted' is treated as an alias
/// for 'completed' by code that reads status).
model PayRun {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @map("organization_id")
  payScheduleId          String?   @map("pay_schedule_id")
  payPeriodStart         DateTime  @map("pay_period_start")
  payPeriodEnd           DateTime  @map("pay_period_end")
  status                 String    @default("draft")
  offCycle               Boolean   @default(false) @map("off_cycle")
  totalGross             Decimal   @default(0) @db.Decimal(20, 6) @map("total_gross")
  totalEmployeeTax       Decimal   @default(0) @db.Decimal(20, 6) @map("total_employee_tax")
  totalEmployerTax       Decimal   @default(0) @db.Decimal(20, 6) @map("total_employer_tax")
  totalPretaxDeductions  Decimal   @default(0) @db.Decimal(20, 6) @map("total_pretax_deductions")
  totalPosttaxDeductions Decimal   @default(0) @db.Decimal(20, 6) @map("total_posttax_deductions")
  totalGarnishments      Decimal   @default(0) @db.Decimal(20, 6) @map("total_garnishments")
  totalReimbursements    Decimal   @default(0) @db.Decimal(20, 6) @map("total_reimbursements")
  totalEmployerBenefitsCost Decimal @default(0) @db.Decimal(20, 6) @map("total_employer_benefits_cost")
  totalNetPay            Decimal   @default(0) @db.Decimal(20, 6) @map("total_net_pay")
  debitDate              DateTime? @map("debit_date")
  employeePaymentDate    DateTime? @map("employee_payment_date")
  taxPaymentDate         DateTime? @map("tax_payment_date")
  providerPayrollId      String?   @map("provider_payroll_id")
  journalEntryId         String?   @unique @map("journal_entry_id")
  reversalOfPayRunId     String?   @unique @map("reversal_of_pay_run_id")
  preparedByUserId       String?   @map("prepared_by_user_id")
  approvedByUserId       String?   @map("approved_by_user_id")
  approvedAt             DateTime? @map("approved_at")
  failureReason          String?   @map("failure_reason")
  postedAt               DateTime? @map("posted_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paySchedule    PaySchedule? @relation(fields: [payScheduleId], references: [id], onDelete: SetNull)
  reversalOf     PayRun?      @relation("PayRunReversal", fields: [reversalOfPayRunId], references: [id], onDelete: SetNull)
  reversedBy     PayRun?      @relation("PayRunReversal")
  lines          PayRunLine[]
  payStubs       PayStub[]

  @@map("pay_runs")
}

model PayRunLine {
  id                   String   @id @default(uuid()) @db.Uuid
  payRunId             String   @map("pay_run_id")
  employeeId           String   @map("employee_id")
  regularHours         Decimal? @db.Decimal(9, 2) @map("regular_hours")
  overtimeHours        Decimal? @db.Decimal(9, 2) @map("overtime_hours")
  grossPay             Decimal  @db.Decimal(20, 6) @map("gross_pay")
  pretaxDeductions     Decimal  @default(0) @db.Decimal(20, 6) @map("pretax_deductions")
  employeeTax          Decimal  @default(0) @db.Decimal(20, 6) @map("employee_tax")
  posttaxDeductions    Decimal  @default(0) @db.Decimal(20, 6) @map("posttax_deductions")
  garnishmentAmount    Decimal  @default(0) @db.Decimal(20, 6) @map("garnishment_amount")
  reimbursements       Decimal  @default(0) @db.Decimal(20, 6) @map("reimbursements")
  employerTax          Decimal  @default(0) @db.Decimal(20, 6) @map("employer_tax")
  employerBenefitsCost Decimal  @default(0) @db.Decimal(20, 6) @map("employer_benefits_cost")
  netPay               Decimal  @default(0) @db.Decimal(20, 6) @map("net_pay")
  projectId            String?  @map("project_id")
  locationId           String?  @map("location_id")
  description          String?
  createdAt            DateTime @default(now()) @map("created_at")

  payRun      PayRun    @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  payStub     PayStub?

  @@map("pay_run_lines")
}

/// Records every plan/billing-cycle/add-on change for an organization.
/// Plan and feature entitlements themselves are defined in src/lib/plans.ts,
/// not in the database — this table is only a change history/audit trail.
model SubscriptionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id")
  planId         String   @map("plan_id")
  billingCycle   String   @map("billing_cycle")
  addOns         String[] @default([]) @map("add_ons")
  /// 'upgraded' | 'downgraded' | 'plan_changed' (same tier rank, e.g. billing-cycle/add-on-only change). Nullable for rows created before this field existed.
  eventType      String?  @map("event_type")
  actorId        String?  @map("actor_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscription_events")
}

/// Submissions from the public /contact-sales marketing form.
model ContactSalesSubmission {
  id                 String   @id @default(uuid()) @db.Uuid
  firstName          String   @map("first_name")
  lastName           String   @map("last_name")
  email              String
  phone              String?
  organizationName   String   @map("organization_name")
  organizationType   String?  @map("organization_type")
  employeeCount      String?  @map("employee_count")
  currentSystem      String?  @map("current_system")
  requiredModules    String[] @default([]) @map("required_modules")
  preferredContact   String?  @map("preferred_contact")
  message             String?
  consentAcknowledged Boolean @default(false) @map("consent_acknowledged")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("contact_sales_submissions")
}

/// Uploaded file metadata (receipts, attachments) linked to any record via
/// relatedType/relatedId. Files are stored on local disk under /uploads in
/// development; see src/lib/documents.ts — no cloud storage provider is
/// configured, so this is not yet durable/production storage.
model Document {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id")
  fileName         String    @map("file_name")
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  storagePath      String    @map("storage_path")
  relatedType      String?   @map("related_type")
  relatedId        String?   @map("related_id")
  uploadedByUserId String?   @map("uploaded_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("documents")
}

/// In-app notifications. userId null = organization-wide notification.
model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  userId         String?   @map("user_id")
  type           String
  title          String
  message        String
  link           String?
  read           Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

/// Pending sign-off on a sensitive action (bill/expense/payment/journal
/// entry over a configured threshold). Approve/reject before the source
/// record may be posted — see src/lib/approvals.ts.
model Approval {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id")
  resourceType      String    @map("resource_type")
  resourceId        String    @map("resource_id")
  status            String    @default("pending")
  amount            Decimal?  @db.Decimal(20, 6)
  /// Parameters needed to execute the pending action once approved (e.g. a
  /// bill payment's amount/paymentDate/method/paymentAccountId). Nothing is
  /// posted to the ledger until an approval with a payload is approved.
  payload           Json?
  note              String?
  requestedByUserId String    @map("requested_by_user_id")
  decidedByUserId   String?   @map("decided_by_user_id")
  decidedAt         DateTime? @map("decided_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("approvals")
}

model ImportJob {
