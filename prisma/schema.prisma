  @@map("exchange_rates")
}

model Dimension {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values         DimensionValue[]

  @@unique([organizationId, name])
  @@map("dimensions")
}

model DimensionValue {
  id            String    @id @default(uuid()) @db.Uuid
  dimensionId   String    @map("dimension_id")
  name          String
  createdAt     DateTime  @default(now()) @map("created_at")

  dimension     Dimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  journalLines  JournalLine[]

  @@unique([dimensionId, name])
  @@map("dimension_values")
}

/// Mileage log entry for business-travel deduction/reimbursement
/// tracking (Lumviq Start and higher). The reimbursable amount is
/// computed and stored at creation time (miles * ratePerMile) and is
/// never recalculated retroactively if the rate later changes.
/// Optionally linked to a Reimbursement once paid out. See
/// docs/known-limitations.md.
model MileageLog {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id")
  userId          String    @map("user_id")
  date            DateTime
  startLocation   String    @map("start_location")
  endLocation     String    @map("end_location")
  purpose         String?
  miles           Decimal   @db.Decimal(10, 2)
  ratePerMile     Decimal   @map("rate_per_mile") @db.Decimal(6, 3)
  amount          Decimal   @db.Decimal(12, 2)
  reimbursementId String?   @map("reimbursement_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("mileage_logs")
}

/// Lightweight 1099 contractor directory entry, optionally linked to a
