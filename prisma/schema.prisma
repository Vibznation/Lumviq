}

/// Credit memo from a vendor, reducing what the organization owes them.
model VendorCredit {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id")
  vendorId         String    @map("vendor_id")
  creditNumber     String    @map("credit_number")
  amount           Decimal   @db.Decimal(20, 6)
  remainingAmount  Decimal   @db.Decimal(20, 6) @map("remaining_amount")
  reason           String?
  expenseAccountId String    @map("expense_account_id")
  journalEntryId   String?   @unique @map("journal_entry_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor           Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@unique([organizationId, creditNumber])
  @@map("vendor_credits")
}

/// Employee/contractor out-of-pocket expense reimbursement request.
model Reimbursement {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id")
  employeeId       String?   @map("employee_id")
  payeeName        String    @map("payee_name")
  amount           Decimal   @db.Decimal(20, 6)
  description      String?
  expenseAccountId String    @map("expense_account_id")
  paymentAccountId String?   @map("payment_account_id")
  status           String    @default("pending")
  journalEntryId   String?   @unique @map("journal_entry_id")
  requestedByUserId String   @map("requested_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines            ReimbursementLine[]

  @@map("reimbursements")
}

/// Physical/warehouse location for multi-location inventory tracking.
model Location {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  address        String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  employees      Employee[]
  payRunLines    PayRunLine[]

  @@map("locations")
}

/// Staff allocation: which users are assigned to a project and at what
/// percentage of their time, used for job-costing/staffing reports.
model ProjectAssignment {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id")
  projectId         String    @map("project_id")
  userId            String    @map("user_id")
  allocationPercent Decimal   @default(100) @db.Decimal(5, 2) @map("allocation_percent")
  roleLabel         String?   @map("role_label")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_assignments")
}

/// One-time donation received (nonprofit).
model Donation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  donorName      String    @map("donor_name")
  donorEmail     String?   @map("donor_email")
  amount         Decimal   @db.Decimal(20, 6)
  date           DateTime
  fundId         String?   @map("fund_id")
  method         String?
  depositAccountId String  @map("deposit_account_id")
  journalEntryId String?   @unique @map("journal_entry_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fund           Fund?        @relation(fields: [fundId], references: [id], onDelete: SetNull)

  @@map("donations")
}

/// A donor's committed future gift (nonprofit); fulfilledAmount tracks
/// progress as matching Donations are recorded against it.
model Pledge {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id")
  donorName        String    @map("donor_name")
  donorEmail       String?   @map("donor_email")
  amount           Decimal   @db.Decimal(20, 6)
  pledgeDate       DateTime  @map("pledge_date")
  dueDate          DateTime? @map("due_date")
  fulfilledAmount  Decimal   @default(0) @db.Decimal(20, 6) @map("fulfilled_amount")
  fundId           String?   @map("fund_id")
  status           String    @default("open")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fund             Fund?        @relation(fields: [fundId], references: [id], onDelete: SetNull)

  @@map("pledges")
}

/// Organization-defined custom field on a given entity type (e.g.
/// "customer", "invoice"). Values are stored separately so fields can be
/// added/removed without a schema migration per field.
model CustomField {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  entityType     String    @map("entity_type")
  name           String
  fieldType      String    @default("text") @map("field_type")
  options        String[]  @default([])
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values         CustomFieldValue[]

  @@unique([organizationId, entityType, name])
  @@map("custom_fields")
}

model CustomFieldValue {
  id            String      @id @default(uuid()) @db.Uuid
  customFieldId String      @map("custom_field_id")
  entityId      String      @map("entity_id")
  value         String?
  createdAt     DateTime    @default(now()) @map("created_at")

  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, entityId])
  @@map("custom_field_values")
}

/// Simple "when X, do Y" automation rule. Evaluated on demand via
/// POST /api/workflows/run-due (no background scheduler exists yet).
model WorkflowRule {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  triggerType    String    @map("trigger_type")
  triggerConfig  Json?     @map("trigger_config")
  actionType     String    @default("notify") @map("action_type")
  active         Boolean   @default(true)
  lastRunAt      DateTime? @map("last_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("workflow_rules")
}

/// User-defined KPI: a labeled sum/average over a set of account balances,
/// surfaced on the executive dashboard.
model KpiDefinition {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  accountIds     String[]  @default([]) @map("account_ids")
  operation      String    @default("sum")
  targetValue    Decimal?  @db.Decimal(20, 6) @map("target_value")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("kpi_definitions")
}

/// A "what-if" budget scenario: percentage adjustments applied to an
/// existing budget/actuals baseline for side-by-side comparison.
model BudgetScenario {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  basedOnActual  Boolean   @default(false) @map("based_on_actual")
  adjustments    Json
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("budget_scenarios")
}

/// In-app support ticket. Priority/response-time expectations are derived
/// from the organization's plan (see src/lib/support.ts) — there is no
/// live chat or ticketing-system integration.
model SupportTicket {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  createdByUserId String   @map("created_by_user_id")
  subject        String
  message        String
  status         String    @default("open")
  priority       String    @default("standard")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

/// Durable background job queue. Recurring templates, workflow rules,
/// webhook deliveries and outbound emails all enqueue work here instead of
/// executing inline, so retries/backoff/failure visibility are consistent.
/// Processing happens when POST /api/jobs/process is called (see
/// docs/deployment.md for wiring an external scheduler/cron to that
/// endpoint) — there is no in-process timer, matching the rest of
/// Lumviq's "no hidden background magic" posture.
model BackgroundJob {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id")
  type           String
  payload        Json
  status         String    @default("pending")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  runAt          DateTime  @default(now()) @map("run_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@map("background_jobs")
}

/// Record of every outbound email Lumviq attempted to send. When no
/// provider is configured (see src/lib/integrations/email.ts) the email is
/// only logged here, never actually delivered — status stays "logged_only".
model EmailLog {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id")
  toAddress      String    @map("to_address")
  subject        String
  body           String
  provider       String
  status         String    @default("logged_only")
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("email_logs")
}

/// Reconciliation of any general-ledger balance-sheet account against an
/// external statement/subledger figure (distinct from bank-feed
/// ReconciliationSession, which only covers bank/credit-card accounts).
model AccountReconciliation {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id")
  accountId         String    @map("account_id")
  periodEndDate     DateTime  @map("period_end_date")
  statementBalance  Decimal   @db.Decimal(20, 6) @map("statement_balance")
  glBalance         Decimal   @db.Decimal(20, 6) @map("gl_balance")
  status            String    @default("in_progress")
  notes             String?
  reconciledByUserId String?  @map("reconciled_by_user_id")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account           Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clearedLines      JournalLine[] @relation("JournalLineAccountReconciliation")

  @@map("account_reconciliations")
}

/// A single task on an accounting period's close checklist (e.g. "Reconcile
/// operating bank account", "Post depreciation", "Review AR aging").
model CloseChecklistItem {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id")
  accountingPeriodId String    @map("accounting_period_id")
  label              String
  status             String    @default("pending")
  assignedToUserId   String?   @map("assigned_to_user_id")
  notes              String?
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountingPeriod   AccountingPeriod @relation(fields: [accountingPeriodId], references: [id], onDelete: Cascade)

  @@map("close_checklist_items")
}

/// Fixed asset register entry. Depreciation is straight-line only —
/// see docs/known-limitations.md for other methods not yet supported.
model FixedAsset {
  id                          String    @id @default(uuid()) @db.Uuid
  organizationId              String    @map("organization_id")
  name                        String
  assetAccountId              String    @map("asset_account_id")
  depreciationExpenseAccountId String   @map("depreciation_expense_account_id")
  accumulatedDepreciationAccountId String @map("accumulated_depreciation_account_id")
  acquisitionDate             DateTime  @map("acquisition_date")
  cost                        Decimal   @db.Decimal(20, 6)
  salvageValue                Decimal   @default(0) @db.Decimal(20, 6) @map("salvage_value")
  usefulLifeMonths            Int       @map("useful_life_months")
  method                      String    @default("straight_line")
  disposedAt                  DateTime? @map("disposed_at")
  disposalAmount              Decimal?  @db.Decimal(20, 6) @map("disposal_amount")
  createdAt                   DateTime  @default(now()) @map("created_at")

  organization                Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  depreciationEntries         DepreciationEntry[]

  @@map("fixed_assets")
}

model DepreciationEntry {
  id             String    @id @default(uuid()) @db.Uuid
  fixedAssetId   String    @map("fixed_asset_id")
  periodDate     DateTime  @map("period_date")
  amount         Decimal   @db.Decimal(20, 6)
  journalEntryId String?   @unique @map("journal_entry_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  fixedAsset     FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)

  @@unique([fixedAssetId, periodDate])
  @@map("depreciation_entries")
}

/// Loan/debt register with an amortization schedule. Interest/principal
/// split uses a standard amortizing-loan formula.
model Loan {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @map("organization_id")
  name                   String
  lenderName             String?   @map("lender_name")
  liabilityAccountId     String    @map("liability_account_id")
  interestExpenseAccountId String  @map("interest_expense_account_id")
  disbursementAccountId  String?   @map("disbursement_account_id")
  principal              Decimal   @db.Decimal(20, 6)
  interestRatePercent    Decimal   @db.Decimal(8, 4) @map("interest_rate_percent")
  termMonths             Int       @map("term_months")
  startDate              DateTime  @map("start_date")
  createdAt              DateTime  @default(now()) @map("created_at")

  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments               LoanPayment[]

  @@map("loans")
}

model LoanPayment {
  id               String    @id @default(uuid()) @db.Uuid
  loanId           String    @map("loan_id")
  paymentDate      DateTime  @map("payment_date")
  amount           Decimal   @db.Decimal(20, 6)
  principalPortion Decimal   @db.Decimal(20, 6) @map("principal_portion")
  interestPortion  Decimal   @db.Decimal(20, 6) @map("interest_portion")
  journalEntryId   String?   @unique @map("journal_entry_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  loan             Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, paymentDate])
  @@map("loan_payments")
}

/// Multi-line item on a Reimbursement, enabling full "expense report"
/// style submissions (several expenses, one reimbursement request).
/// When lines exist, Reimbursement.amount is kept as their sum.
model ReimbursementLine {
  id               String    @id @default(uuid()) @db.Uuid
  reimbursementId  String    @map("reimbursement_id")
  date             DateTime
  description      String
  amount           Decimal   @db.Decimal(20, 6)
  expenseAccountId String    @map("expense_account_id")
  documentId       String?   @map("document_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  reimbursement    Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  @@map("reimbursement_lines")
}

/// Goods receipt against a PurchaseOrder, enabling 3-way matching
/// (purchase order vs. receipt vs. bill) before a bill is paid.
model PurchaseOrderReceipt {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id")
  purchaseOrderId String    @map("purchase_order_id")
  receivedDate    DateTime  @map("received_date")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lines           PurchaseOrderReceiptLine[]

  @@map("purchase_order_receipts")
}

model PurchaseOrderReceiptLine {
  id                      String    @id @default(uuid()) @db.Uuid
  purchaseOrderReceiptId  String    @map("purchase_order_receipt_id")
  purchaseOrderLineId     String    @map("purchase_order_line_id")
  quantityReceived        Decimal   @db.Decimal(20, 6) @map("quantity_received")

  purchaseOrderReceipt    PurchaseOrderReceipt @relation(fields: [purchaseOrderReceiptId], references: [id], onDelete: Cascade)

  @@map("purchase_order_receipt_lines")
}

/// Time-limited guest-access token letting a customer view/pay a single
/// invoice without a Lumviq account (customer portal).
model InvoicePortalToken {
  id             String    @id @default(uuid()) @db.Uuid
  invoiceId      String    @map("invoice_id")
  token          String    @unique
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("invoice_portal_tokens")
}

/// Time-limited guest-access token letting a vendor upload a bill/receipt
/// for an organization without a Lumviq account (vendor portal).
model VendorUploadToken {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  vendorId       String    @map("vendor_id")
  token          String    @unique
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_upload_tokens")
}

/// Intercompany transaction between two linked organizations (parent/child
/// per Organization.parentOrganizationId). Posts a due-to/due-from journal
/// entry on each side and can be marked eliminated for consolidated
/// reporting (see src/lib/consolidation.ts).
model IntercompanyTransaction {
  id                       String    @id @default(uuid()) @db.Uuid
  organizationId           String    @map("organization_id")
  counterpartyOrganizationId String  @map("counterparty_organization_id")
  description              String?
  amount                   Decimal   @db.Decimal(20, 6)
  dueToAccountId           String    @map("due_to_account_id")
  dueFromAccountId         String    @map("due_from_account_id")
  journalEntryId           String?   @unique @map("journal_entry_id")
  counterpartyJournalEntryId String? @unique @map("counterparty_journal_entry_id")
  eliminated               Boolean   @default(false)
  createdAt                DateTime  @default(now()) @map("created_at")

  organization             Organization @relation("IntercompanyOwner", fields: [organizationId], references: [id], onDelete: Cascade)
  counterpartyOrganization Organization @relation("IntercompanyCounterparty", fields: [counterpartyOrganizationId], references: [id], onDelete: Cascade)

  @@map("intercompany_transactions")
}

/// A recurring pay-frequency configuration employees are assigned to
/// (e.g. weekly, biweekly, semimonthly, monthly). Drives the payroll-run
/// calendar and Auto Payroll eligibility.
model PaySchedule {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id")
  name               String
  /// 'weekly' | 'biweekly' | 'semimonthly' | 'monthly'
  frequency          String    @default("biweekly")
  anchorDate         DateTime  @map("anchor_date")
  nextPayDate        DateTime? @map("next_pay_date")
  autoPayrollEnabled Boolean   @default(false) @map("auto_payroll_enabled")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]
  payRuns      PayRun[]

  @@map("pay_schedules")
}

/// Federal/state withholding elections (W-4 / state equivalent), one row
/// per employee. Only non-sensitive summary fields are ever returned by
/// the API; nothing here is passed to Lumviq Intelligence/AI features.
model EmployeeTaxProfile {
  id                      String    @id @default(uuid()) @db.Uuid
  employeeId              String    @unique @map("employee_id")
  filingStatus            String    @default("single") @map("filing_status")
  federalAllowances       Int       @default(0) @map("federal_allowances")
  federalExtraWithholding Decimal   @default(0) @db.Decimal(12, 2) @map("federal_extra_withholding")
  state                   String?
  stateFilingStatus       String?   @map("state_filing_status")
  stateAllowances         Int       @default(0) @map("state_allowances")
  stateExtraWithholding   Decimal   @default(0) @db.Decimal(12, 2) @map("state_extra_withholding")
  multiStateWorkStates    String[]  @default([]) @map("multi_state_work_states")
  exemptFromFederal       Boolean   @default(false) @map("exempt_from_federal")
  exemptFromState         Boolean   @default(false) @map("exempt_from_state")
  providerTaxProfileId    String?   @map("provider_tax_profile_id")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  createdAt               DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_tax_profiles")
}

/// Direct-deposit destination for an employee or contractor. Raw account
/// and routing numbers are AES-256-GCM encrypted at rest
/// (src/lib/encryption.ts); only accountLast4 + bankName are ever
/// surfaced through the API.
model DirectDepositAccount {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @map("organization_id")
  /// 'employee' | 'contractor'
  ownerType              String    @map("owner_type")
  employeeId             String?   @map("employee_id")
  contractorId           String?   @map("contractor_id")
  bankName               String?   @map("bank_name")
  accountType            String    @default("checking") @map("account_type")
  routingNumberEncrypted String    @map("routing_number_encrypted")
  accountNumberEncrypted String    @map("account_number_encrypted")
  accountLast4           String    @map("account_last4")
  /// 'amount' | 'percent' | 'remainder'
  splitType              String    @default("remainder") @map("split_type")
  splitValue             Decimal?  @db.Decimal(20, 6) @map("split_value")
  priority               Int       @default(1)
  /// 'pending' | 'verified' | 'failed'
  verificationStatus     String    @default("pending") @map("verification_status")
  providerAccountId      String?   @map("provider_account_id")
  active                 Boolean   @default(true)
  createdAt              DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractor   Contractor?  @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("direct_deposit_accounts")
}

/// Pretax/post-tax deduction or employer-paid benefit line attached to an
/// employee (medical/dental/vision premium, 401(k)/HSA/FSA, etc.).
model Deduction {
  id                  String    @id @default(uuid()) @db.Uuid
  employeeId          String    @map("employee_id")
  category            String
  /// 'pretax' | 'posttax' | 'employer_only'
  taxTreatment        String    @default("pretax") @map("tax_treatment")
  /// 'fixed_amount' | 'percent_of_gross'
  calculationMethod   String    @default("fixed_amount") @map("calculation_method")
  employeeAmount      Decimal   @default(0) @db.Decimal(20, 6) @map("employee_amount")
  employerAmount      Decimal   @default(0) @db.Decimal(20, 6) @map("employer_amount")
  annualLimit         Decimal?  @db.Decimal(20, 6) @map("annual_limit")
  effectiveDate       DateTime  @map("effective_date")
  endDate             DateTime? @map("end_date")
  priority            Int       @default(1)
  providerDeductionId String?   @map("provider_deduction_id")
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("deductions")
}

/// Legally-ordered wage garnishment (child support, tax levy, creditor
/// garnishment, etc.). Lumviq applies the provider's withholding
/// calculation and does not give legal advice about priority ordering.
model Garnishment {
  id                     String    @id @default(uuid()) @db.Uuid
  employeeId             String    @map("employee_id")
  garnishmentType        String    @map("garnishment_type")
  orderNumber            String?   @map("order_number")
  issuingAgency          String?   @map("issuing_agency")
  /// 'fixed_amount' | 'percent_of_disposable'
  calculationMethod      String    @default("fixed_amount") @map("calculation_method")
  amount                 Decimal   @default(0) @db.Decimal(20, 6)
  maxPercentOfDisposable Decimal?  @db.Decimal(5, 2) @map("max_percent_of_disposable")
  priority               Int       @default(1)
  remainingBalance       Decimal?  @db.Decimal(20, 6) @map("remaining_balance")
  effectiveDate          DateTime  @map("effective_date")
  endDate                DateTime? @map("end_date")
  providerGarnishmentId  String?   @map("provider_garnishment_id")
  active                 Boolean   @default(true)
  createdAt              DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("garnishments")
}

/// Accrual policy for a PTO/sick-leave category (organization-level
/// definition; employees accrue against it via PtoBalance).
model PtoPolicy {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  name           String
  category       String    @default("vacation")
  /// 'per_pay_period' | 'annual_grant' | 'hours_worked'
  accrualMethod  String    @default("per_pay_period") @map("accrual_method")
  accrualRate    Decimal   @default(0) @db.Decimal(10, 4) @map("accrual_rate")
  maxBalance     Decimal?  @db.Decimal(10, 2) @map("max_balance")
  carryoverLimit Decimal?  @db.Decimal(10, 2) @map("carryover_limit")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  balances     PtoBalance[]

  @@map("pto_policies")
}

model PtoBalance {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @map("employee_id")
  ptoPolicyId  String   @map("pto_policy_id")
  balanceHours Decimal  @default(0) @db.Decimal(10, 2) @map("balance_hours")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ptoPolicy PtoPolicy @relation(fields: [ptoPolicyId], references: [id], onDelete: Cascade)

  @@unique([employeeId, ptoPolicyId])
  @@map("pto_balances")
}

model PtoRequest {
  id              String    @id @default(uuid()) @db.Uuid
  employeeId      String    @map("employee_id")
  ptoPolicyId     String?   @map("pto_policy_id")
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  hours           Decimal   @db.Decimal(10, 2)
  status          String    @default("pending")
  reason          String?
  decidedByUserId String?   @map("decided_by_user_id")
  decidedAt       DateTime? @map("decided_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("pto_requests")
}

/// A federal/state/local payroll-tax filing obligation surfaced from the
/// payroll provider (Form 941, 940, state withholding/unemployment
/// returns, etc.). Lumviq displays and tracks status; the licensed
/// provider remains the system of record for the actual filing.
model TaxFiling {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id")
  jurisdiction         String
  formType             String    @map("form_type")
  filingPeriodStart    DateTime  @map("filing_period_start")
  filingPeriodEnd      DateTime  @map("filing_period_end")
  dueDate              DateTime  @map("due_date")
  amount               Decimal?  @db.Decimal(20, 6)
  status               String    @default("pending")
  providerFilingId     String?   @map("provider_filing_id")
  providerConfirmation String?   @map("provider_confirmation")
  failureReason        String?   @map("failure_reason")
  filedAt              DateTime? @map("filed_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("tax_filings")
}

/// Generated employee/contractor tax document (W-2, W-3, 1099-NEC,
/// 1099-MISC) for a given tax year, sourced from the payroll provider.
model PayrollTaxDocument {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id")
  /// 'employee' | 'contractor'
  ownerType          String    @map("owner_type")
  employeeId         String?   @map("employee_id")
  contractorId       String?   @map("contractor_id")
  documentType       String    @map("document_type")
  taxYear            Int       @map("tax_year")
  status             String    @default("pending")
  providerDocumentId String?   @map("provider_document_id")
  deliveredAt        DateTime? @map("delivered_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("payroll_tax_documents")
}

/// Generated paystub for a single employee within a pay run.
model PayStub {
  id             String   @id @default(uuid()) @db.Uuid
  payRunId       String   @map("pay_run_id")
  payRunLineId   String   @unique @map("pay_run_line_id")
  employeeId     String   @map("employee_id")
  payDate        DateTime @map("pay_date")
  correctedForId String?  @map("corrected_for_id")
  createdAt      DateTime @default(now()) @map("created_at")

  payRun     PayRun     @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  payRunLine PayRunLine @relation(fields: [payRunLineId], references: [id], onDelete: Cascade)

  @@map("pay_stubs")
}

/// Generic association between a Lumviq record and an external payroll
/// provider's identifier (Check, Gusto Embedded, etc.). Mirrors the
/// existing Document.relatedType/relatedId polymorphic pattern instead of
/// adding a providerId column to every payroll-adjacent table.
model PayrollProviderLink {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  provider       String
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  externalId     String    @map("external_id")
  status         String    @default("active")
  metadata       Json?
  syncedAt       DateTime? @map("synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provider, entityType, entityId])
  @@map("payroll_provider_links")
}

/// Idempotency ledger for inbound payroll-provider webhooks — a
/// (provider, externalEventId) pair is processed at most once, mirroring
/// the idempotencyKey pattern already used for journal entries
/// (src/lib/payroll.ts).
model PayrollWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String?   @map("organization_id")
  provider        String
  externalEventId String    @map("external_event_id")
  eventType       String    @map("event_type")
  payload         Json
  processedAt     DateTime? @map("processed_at")
  status          String    @default("received")
  error           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@map("payroll_webhook_events")
}


