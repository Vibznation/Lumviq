  organizationId String    @map("organization_id")
  name           String
  type           String    @default("unrestricted")
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grants         Grant[]
  journalEntries JournalEntry[]
  donations      Donation[]
  pledges        Pledge[]

  @@map("funds")
}

model Grant {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id")
  fundId         String?   @map("fund_id")
  name           String
  grantorName    String    @map("grantor_name")
  totalAwarded   Decimal   @db.Decimal(20, 6) @map("total_awarded")
  amountSpent    Decimal   @default(0) @db.Decimal(20, 6) @map("amount_spent")
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fund           Fund?     @relation(fields: [fundId], references: [id], onDelete: SetNull)

  @@map("grants")
