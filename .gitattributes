* text=auto

# Keep shell scripts LF so they run in Linux/CI/Codespaces.
*.sh text eol=lf

# Keep Windows scripts CRLF for local PowerShell/CMD ergonomics.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Normalize common source and config files to LF.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sql text eol=lf
